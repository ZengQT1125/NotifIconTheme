<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：不声明 queries 的话 queryIntentActivities 只返回系统那几个应用，
         白名单列表就只剩 6 项，微信这些全查不到。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="通知图标跟随主题"
        android:supportsRtl="true">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="把桌面图标包里的图标接到状态栏 / 通知中心 / 锁屏岛，通知图标不再割裂" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="通知图标跟随主题"
            android:theme="@style/Theme.SpudIcon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AvatarWhitelistActivity"
            android:exported="false"
            android:label="头像白名单"
            android:theme="@style/Theme.SpudIcon" />

        <provider
            android:name=".ConfigProvider"
            android:authorities="com.littletater.notificontheme.config"
            android:exported="true"
            android:enabled="true" />
    </application>
</manifest>
